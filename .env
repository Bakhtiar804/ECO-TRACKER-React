# EcoTracker Environment Variables
# This file is for local development only

# WAQI API Token (for fallback to ground station data)
# Get your token from: https://aqicn.org/data-platform/token/
# WARNING: This token is exposed in frontend bundle. For production, use a backend proxy.
VITE_WAQI_TOKEN=3029d076cfb4138a837e34c0c6c31793297630ed

# API Configuration
VITE_API_PROVIDER=https://air-quality-api.open-meteo.com/v1/air-quality?latitude=24.8607&longitude=67.0011&current=pm10,pm2_5,carbon_monoxide,nitrogen_dioxide,sulphur_dioxide,ozone,us_aqi,european_aqi&hourly=pm10,pm2_5&timezone=Asia%2FKarachi

# App Configuration
VITE_APP_TITLE=EcoTracker
VITE_DEFAULT_CITY=karachi