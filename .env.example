# EcoTracker Environment Variables
# Copy this file to .env and fill in your values

# WAQI API Token (optional - for fallback to ground station data)
# Get your token from: https://aqicn.org/data-platform/token/
# Note: Never expose this in production frontend - use a backend proxy
VITE_WAQI_TOKEN=your_waqi_token_here

# API Configuration
VITE_API_PROVIDER=open-meteo
# Options: open-meteo (default, free, no key), waqi (requires token)

# App Configuration
VITE_APP_TITLE=EcoTracker
VITE_DEFAULT_CITY=karachi